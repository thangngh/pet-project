# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=*

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ddd_project
DB_LOGGING=false

# Database — Per Context (docs/decision.md D4)
#
# Each bounded context gets its own connection pool and its own PostgreSQL
# schema. Unset, a context falls back to the shared DB_* values above: same
# server, same database, its own pool and schema.
#
# Setting a context's HOST and DATABASE moves it to a database of its own —
# that is the entire migration path, with no code change. Do not uncomment
# these until the matching service in docker-compose.multi-db.yml is running,
# or that context will point at a port with nothing behind it.
#
# DB_CATALOG_HOST=localhost
# DB_CATALOG_PORT=5434
# DB_CATALOG_DATABASE=ddd_catalog
# DB_CATALOG_USERNAME=postgres
# DB_CATALOG_PASSWORD=postgres

# Pool size per context (default 10 each)
# DB_AUTH_POOL_SIZE=10
# DB_USER_POOL_SIZE=10
# DB_CATALOG_POOL_SIZE=10
# DB_PRODUCT_POOL_SIZE=10

# Rate Limit
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Feature Gates
#
# FEATURE_RBAC is required, not optional: with it off, all eleven @Roles('admin')
# endpoints accept any authenticated caller. Before switching it on, make sure
# an admin exists — `pnpm seed:admin` — or it locks those endpoints against
# everybody, including you.
FEATURE_RBAC=true
FEATURE_ABAC=false
FEATURE_USER_PROFILE=true
FEATURE_PRODUCT_CATALOG=true
FEATURE_SHIPPING=false

# Logging
LOG_LEVEL=info

# Admin seed (pnpm seed:admin) — the only way to create the first admin.
# Registration cannot grant a role and the promote endpoint needs an admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-Passw0rd
